# Copier en .env.local et remplir avec des clés de DÉVELOPPEMENT uniquement.
# Les clés de production n'existent que dans Vercel (variables marquées « sensibles »).

# ── Public (exposé au navigateur) — jamais de clé privée ici ──
NEXT_PUBLIC_SUPABASE_URL=https://qmweywmldehnsjhqexbl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Privé (serveur uniquement) ──
# Connexion Postgres directe (worker, imports, webhooks). Supabase → Connect → Transaction pooler.
# Ne pas ajouter de paramètre sslmode : la vérification TLS est gérée par DATABASE_CA_CERT.
DATABASE_URL=
# Certificat de l'autorité Supabase (Dashboard → Database → SSL Configuration → Download certificate),
# contenu PEM sur une ligne avec des \n.
DATABASE_CA_CERT=

# Secret partagé avec pg_cron pour appeler /api/worker/tick (32 caractères minimum, aléatoire).
WORKER_SECRET=

# Unipile : "simule" (par défaut, aucun appel LinkedIn) ou "reel" (production uniquement).
UNIPILE_MODE=simule
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
# Secret de l'endpoint webhook (Dashboard Unipile → Webhooks).
UNIPILE_WEBHOOK_SECRET=
