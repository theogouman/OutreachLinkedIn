# Copier en .env.local et remplir avec des clés de DÉVELOPPEMENT uniquement.
# Les clés de production n'existent que dans Vercel (variables marquées « sensibles »).

# Public (exposé au navigateur) — jamais de clé privée ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privé (serveur uniquement) — à ajouter quand une fonctionnalité en a besoin.
# SUPABASE_SECRET_KEY=
